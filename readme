# Esto solamente se hace la PRIMERA VEZ que se enlaza el proyecto con el repositorio, ya para insertar actualizaciones en el repositorio se hace de otra forma

# Ejecutar estos comandos en secuencia

cd ruta/de/tu/proyecto
git init
git remote add origin https://github.com/tu-usuario/tu-repositorio.git
git add .
git commit -m "Initial commit"
git branch -M main
git push -u origin main
git remote remove origin


# -------------------- PARA ACTUALIZACIONES ------------------------ #

git add .
git commit -m "mensaje"
git push

## LEA ESTO ANTES DE EJECUTAR LOS COMANDOS DE ACTUALIZACION, IMPORTANTE!! 

cuando trate de importar el proyecto en otra pc que no es la misma en donde se vinculo el proyecto con el repositorio de github por PRIMERA VEZ, tiene que verificar que tenga instalado el git y despues de eso ejecutamos estos comandos, para que los comandos de actualizacion ahora si funcione, SI NO SE HACE, cuando usted ejecute este comando git commit -m "mensaje", le sale un error


## LOS DATOS PUEDEN SER CUALQUIERA, lo importante es que ejecute estos comandos

git config --global user.email "tu-email@gmail.com"
git config --global user.name "Tu Nombre"


despues de ejecutar estos comandos, ya podemos utilizar los comandos de actualizacion de para ir haciendo cambios en el repositorio

# --------------- DESCARGAR LOS ULTIMOS CAMBIOS QUE SE HAN HECHO EN EL REPOSITORIO -------------------- #
git pull

Este comando hace que nuestro proyecto local que estemos trabajando en nuestra pc, se acualize con los ultimos cambios que el equipo de desarrollo a hecho en el repositorio.


# -------------------- IMPORTAR EL PROYECTO EN CUALQUIER PC ------------------------ #

# Clonar el repositorio
git clone https://github.com/leandro232323/repositorioPrueba.git



# ----------------  ELIMINA TODO ACERCA DE GIT que este enlazado con el proyecto --------------------- #
Get-ChildItem -Hidden -Filter ".git"




