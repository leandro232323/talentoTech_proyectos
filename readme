# Esto solamente se hace la PRIMERA VEZ que se enlaza el proyecto con el repositorio, ya para insertar actualizaciones en el repositorio se hace de otra forma

# Ejecutar estos comandos en secuencia

cd ruta/de/tu/proyecto
git init
git remote add origin https://github.com/tu-usuario/tu-repositorio.git
git add .
git commit -m "Initial commit"
git branch -M main
git push -u origin main
git remote remove origin


# -------------------- PARA ACTUALIZACIONES ------------------------ #

git add .
git commit -m "mensaje"
git push


# -------------------- IMPORTAR EL PROYECTO EN CUALQUIER PC ------------------------ #

# Clonar el repositorio
git clone https://github.com/leandro232323/repositorioPrueba.git



# ----------------  ELIMINA TODO ACERCA DE GIT que este enlazado con el proyecto --------------------- #
Get-ChildItem -Hidden -Filter ".git"
